# Copy to `.env.local` (gitignored) and uncomment what you want to override.
# Vite only exposes variables prefixed with `VITE_`; restart `pnpm dev` after editing.

# Backend the frontend talks to. Default is the production API.
# VITE_API_BASE_URL=http://localhost:8000

# Base for generated "shared plan" links.
# VITE_SHARE_BASE_URL=http://localhost:5173/shared

# FIO REST API.
# VITE_FIO_BASE_URL=https://rest.fnar.net

# IndexedDB database name. Change it to keep local cached game data
# separate from another checkout's.
# NOTE: the key is misspelled in src/lib/config.ts (DBNANAME); that spelling
# is the one that actually takes effect.
# VITE_INDEXEDDB_DBNANAME=prunplanner

# Static game data staleness, in minutes.
# VITE_GAME_DATA_STALE_MINUTES_BUILDINGS=1440
# VITE_GAME_DATA_STALE_MINUTES_RECIPES=1440
# VITE_GAME_DATA_STALE_MINUTES_MATERIALS=1440
# VITE_GAME_DATA_STALE_MINUTES_EXCHANGES=60
# VITE_GAME_DATA_STALE_MINUTES_PLANETS=720

# PostHog key served through /env.js. Leave unset in dev to keep analytics off.
# POSTHOG_KEY=
